{
  "name": "cropsize-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:core": "node ../scripts/build-core.mjs",
    "test": "npm run build:core && vitest run",
    "build": "npm run build:core && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cropsize --branch main"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "split.js": "^1.6.5"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
