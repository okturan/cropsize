# Cloudflare Pages headers.
# Cross-origin isolation is what lets ONNX Runtime Web use threaded WASM. Without it ORT
# silently falls back to single-threaded and the encoder takes several times longer.
/*
  Cross-Origin-Opener-Policy: same-origin
  # credentialless rather than require-corp: it still unlocks threaded WASM in Chrome while
  # letting the model download from Hugging Face without needing a CORP header from them.
  Cross-Origin-Embedder-Policy: credentialless
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
